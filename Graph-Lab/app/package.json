{
  "name": "graph-lab",
  "productName": "Graph Lab",
  "version": "1.1.0",
  "description": "Learn graph algorithms with 3D visualizations and real C++",
  "main": "main.js",
  "author": "Graph Lab",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "app.graphlab.desktop",
    "productName": "Graph Lab",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "three.min.js",
      "graphlab.h",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../mingw",
        "to": "mingw"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": false
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "^26.0.0"
  }
}